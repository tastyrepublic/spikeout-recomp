+/******************************************************************************
+ spikeout-recomp's 3D frame dump (added for its comparison tool, tools/supermodel)
+
+ Every number little-endian: "M3FRDUMP", u32 version (1), u32 game mark (the
+ encryption key), u32 flags (bit 0: block culling), u32 configuration
+ registers[4], u32 words of low culling RAM, of high culling RAM, of polygon
+ RAM, u32 texture width, height; then those memories in that order, 32-bit
+ words as the Real3D reads them, the texels 16-bit, row by row.
+******************************************************************************/
+
+#include <fstream>
+#include <vector>
+
+namespace
+{
+  const char kFrameDumpMagic[8] = { 'M', '3', 'F', 'R', 'D', 'U', 'M', 'P' };
+  const uint32_t kFrameDumpVersion = 1;
+  const uint32_t kDumpLoWords = 0x400000 / 4, kDumpHiWords = 0x100000 / 4, kDumpPolyWords = 0x400000 / 4;
+
+  void Put32(std::vector<uint8_t> &out, uint32_t v)
+  {
+    for (int i = 0; i < 4; i++)
+      out.push_back(uint8_t(v >> (8 * i)));
+  }
+
+  uint32_t Get32(const std::vector<uint8_t> &in, size_t at)
+  {
+    return uint32_t(in[at]) | uint32_t(in[at + 1]) << 8 | uint32_t(in[at + 2]) << 16 | uint32_t(in[at + 3]) << 24;
+  }
+}
+
+bool CReal3D::WriteFrameDump(const std::string &path, uint32_t mark, std::string &error) const
+{
+  std::vector<uint8_t> out(kFrameDumpMagic, kFrameDumpMagic + 8);
+  out.reserve(64 + 4 * (kDumpLoWords + kDumpHiWords + kDumpPolyWords) + 2 * 2048 * 2048);
+  Put32(out, kFrameDumpVersion);
+  Put32(out, mark);
+  Put32(out, (m_modeword[static_cast<int>(CASIC::Name::Mercury)] & 4) ? 1 : 0);
+  for (uint32_t r : m_configRegisters.regs)
+    Put32(out, r);
+  Put32(out, kDumpLoWords);
+  Put32(out, kDumpHiWords);
+  Put32(out, kDumpPolyWords);
+  Put32(out, 2048);
+  Put32(out, 2048);
+  for (uint32_t i = 0; i < kDumpLoWords; i++)   Put32(out, cullingRAMLo[i]);
+  for (uint32_t i = 0; i < kDumpHiWords; i++)   Put32(out, cullingRAMHi[i]);
+  for (uint32_t i = 0; i < kDumpPolyWords; i++) Put32(out, polyRAM[i]);
+  for (uint32_t i = 0; i < 2048 * 2048; i++)
+  {
+    out.push_back(uint8_t(textureRAM[i]));
+    out.push_back(uint8_t(textureRAM[i] >> 8));
+  }
+  std::ofstream file(path, std::ios::binary);
+  file.write(reinterpret_cast<const char *>(out.data()), std::streamsize(out.size()));
+  if (!file)
+  {
+    error = "can't write " + path;
+    return false;
+  }
+  return true;
+}
+
+bool CReal3D::LoadFrameDump(const std::string &path, uint32_t mark, std::string &error)
+{
+  std::ifstream file(path, std::ios::binary);
+  std::vector<uint8_t> in((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  const size_t header = 8 + 4 * 12;
+  if (in.size() < header || !std::equal(kFrameDumpMagic, kFrameDumpMagic + 8, in.begin()))
+  {
+    error = "not a 3D frame dump";
+    return false;
+  }
+  if (Get32(in, 8) != kFrameDumpVersion || Get32(in, 12) != mark)
+  {
+    error = "a 3D frame dump of another version or game";
+    return false;
+  }
+  if (Get32(in, 36) != kDumpLoWords || Get32(in, 40) != kDumpHiWords || Get32(in, 44) != kDumpPolyWords ||
+      Get32(in, 48) != 2048 || Get32(in, 52) != 2048 ||
+      in.size() != header + 4 * size_t(kDumpLoWords + kDumpHiWords + kDumpPolyWords) + 2 * 2048 * 2048)
+  {
+    error = "a 3D frame dump of other memory sizes, or cut short";
+    return false;
+  }
+  if (Get32(in, 16) & 1)
+    m_modeword[static_cast<int>(CASIC::Name::Mercury)] |= 4;
+  else
+    m_modeword[static_cast<int>(CASIC::Name::Mercury)] &= ~4u;
+  for (int i = 0; i < 4; i++)
+    m_configRegisters.regs[i] = Get32(in, 20 + 4 * i);
+  size_t at = header;
+  for (uint32_t i = 0; i < kDumpLoWords; i++, at += 4)   cullingRAMLo[i] = Get32(in, at);
+  for (uint32_t i = 0; i < kDumpHiWords; i++, at += 4)   cullingRAMHi[i] = Get32(in, at);
+  for (uint32_t i = 0; i < kDumpPolyWords; i++, at += 4) polyRAM[i] = Get32(in, at);
+  for (uint32_t i = 0; i < 2048 * 2048; i++, at += 2)
+    textureRAM[i] = uint16_t(in[at] | in[at + 1] << 8);
+  if (m_gpuMultiThreaded)
+    UpdateSnapshots(true);
+  Render3D->SetBlockCulling((m_modeword[static_cast<int>(CASIC::Name::Mercury)] & 4) == 4);
+  Render3D->UploadTextures(0, 0, 0, 2048, 2048);
+  return true;
+}
